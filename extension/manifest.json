{
  "manifest_version": 3,
  "name": "ytgrab",
  "version": "0.2.0",
  "description": "Send the current YouTube video to the ytgrab app.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Download with ytgrab",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["button.js"], "css": ["button.css"] }],
  "web_accessible_resources": [{ "resources": ["icons/32.png"], "matches": ["https://www.youtube.com/*"] }],
  "permissions": ["cookies", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "http://127.0.0.1:47321/*"]
}
